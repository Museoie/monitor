# Loaded automatically by ecosystem.config.js (no need to source this
# file); a variable set in the shell wins over the value here.
# Required
DISCORD_ALARM_WEBHOOK=https://discord.com/api/webhooks/...
LOG_SERVER_TOKEN=your-secret-token-here
MONITOR_PROJECT=myproject             # monitor every service of this compose project
# MONITOR_TARGETS=inbox,budget        # or a fixed comma-separated list (used only without MONITOR_PROJECT)

# Optional (defaults shown)
LOG_PORT=9000
HEALTH_POLL_INTERVAL_MS=60000         # 60s
HEALTH_FAIL_THRESHOLD=1               # alarms on first failure
ALARM_COOLDOWN_MS=60000               # 1 min between alarms for same type+service
DOCKER_SOCKET=/var/run/docker.sock
JOURNALCTL_BIN=journalctl             # override if not on PATH (e.g. /usr/bin/journalctl)
JOURNALCTL_TIMEOUT_MS=15000           # hard-kill journalctl if it hangs
STATS_POLL_INTERVAL_MS=1000           # docker stats poll interval per container (1s base for tiered retention)
STATS_DATA_DIR=stats-data             # segmented stats store (resolved next to monitor.js); raw + rollup segments, pruned per tier
STATS_RAW_RETENTION_DAYS=30           # raw 1-second samples kept (rollup tiers keep 90d–3y; see README)
MEMORY_PRESSURE_RATIO=0.85            # alarm when usage/limit >= this
MEMORY_PRESSURE_SUSTAINED_MS=180000   # sustained wall-clock ms above the ratio before alarming
